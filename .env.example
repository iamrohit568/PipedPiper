# Piped Piper Environment Variables Template
# Copy this file to a new file named .env and fill in the actual values.
# The .env file is ignored by git to keep your secrets safe.

# --- API KEYS ---
YOUTUBE_API_KEY=your_youtube_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- DATABASE ---
MYSQL_HOSTNAME=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=yt_scrapper
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# --- OPTIONAL ---
PORT=8080
TRANSCRIPT_API_PROVIDER=local
TRANSCRIPT_API_KEY=your_transcript_api_key_here
